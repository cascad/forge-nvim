* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
*.bats text eol=lf
tests/e2e/fixtures/terminal-shell/pwsh text eol=lf
*.ps1 text eol=crlf
*.lua text eol=lf
*.md text eol=lf
*.json text eol=lf
# Unified diff содержит обязательный пробел в пустых строках контекста.
*.patch text eol=lf -whitespace

# Архивные источники сохраняют исходные байты; SHA256 указан в sources.json.
docs/history/legacy/** -text
