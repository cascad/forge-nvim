+// queryCommandPrefix использует уже построенный AST только для выбора Query/Exec.
+// В саму БД отправляется прежний query, включая комментарии и optimizer hints.
+func queryCommandPrefix(stmt *ast.Statement) string {
+	for i, node := range stmt.Toks {
+		if item, ok := node.(ast.Token); ok {
+			switch item.GetToken().Kind {
+			case token.Whitespace, token.Comment, token.MultilineComment:
+				continue
+			}
+		}
+		return strings.TrimSpace((&ast.Statement{Toks: stmt.Toks[i:]}).String())
+	}
+	return ""
+}
